{
  "name": "vocero-crm",
  "version": "1.4.0",
  "description": "CRM de WhatsApp open source y self-hosted con agente de IA y Laboratorio de auto-evaluación",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/migrate.mjs && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "MIGRATIONS_DIR=drizzle node scripts/migrate.mjs && MIGRATIONS_DIR=drizzle node scripts/migrate.mjs && vitest run -c vitest.db.config.ts",
    "test:e2e": "node --env-file=.env scripts/e2e-selftest.mjs",
    "test:e2e:calendario": "node --env-file=.env scripts/e2e-calendario.mjs",
    "test:e2e:resultados": "node --env-file=.env scripts/e2e-resultados.mjs",
    "test:e2e:roles": "node --env-file=.env scripts/e2e-roles.mjs",
    "test:e2e:campanas": "node --env-file=.env scripts/e2e-campanas.mjs",
    "test:e2e:panel": "node --env-file=.env scripts/e2e-panel-perdido.mjs",
    "test:e2e:linea": "node --env-file=.env scripts/e2e-linea-tiempo.mjs",
    "test:e2e:redaccion": "node --env-file=.env scripts/e2e-redaccion.mjs",
    "test:e2e:conocimientos": "node --env-file=.env scripts/e2e-conocimientos.mjs",
    "test:e2e:compositor": "node --env-file=.env scripts/e2e-compositor.mjs",
    "test:e2e:firma": "node --env-file=.env scripts/e2e-firma-webhook.mjs",
    "test:e2e:chat": "node --env-file=.env scripts/e2e-chat-equipo.mjs",
    "test:e2e:participantes": "node --env-file=.env scripts/e2e-participantes-menciones.mjs",
    "test:e2e:multiorg": "node --env-file=.env scripts/e2e-multiorg.mjs",
    "test:e2e:credenciales": "node --env-file=.env scripts/e2e-credenciales.mjs",
    "test:e2e:plataforma": "node --env-file=.env scripts/e2e-plataforma.mjs",
    "test:e2e:modulos": "node --env-file=.env scripts/e2e-modulos.mjs",
    "test:e2e:datos-meta": "node --env-file=.env scripts/e2e-datos-meta.mjs",
    "test:e2e:campanas-v2": "node --env-file=.env scripts/e2e-campanas-v2.mjs",
    "test:e2e:navegacion": "node --env-file=.env scripts/e2e-navegacion.mjs",
    "test:e2e:agentes": "node --env-file=.env scripts/e2e-agentes.mjs",
    "test:e2e:apariencia": "node --env-file=.env scripts/e2e-apariencia.mjs",
    "test:e2e:trabajo": "node --env-file=.env scripts/e2e-trabajo.mjs",
    "test:e2e:numero-nuevo": "node --env-file=.env scripts/e2e-numero-nuevo.mjs",
    "test:e2e:documentos": "node --env-file=.env scripts/e2e-documentos.mjs",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:demo": "esbuild scripts/seed/demo.ts --bundle --platform=node --format=esm --outfile=.tmp-seed-demo.mjs --alias:@=./src --packages=external && node .tmp-seed-demo.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "better-auth": "^1.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "emojibase-data": "^17.0.0",
    "fflate": "0.8.3",
    "frimousse": "^0.4.0",
    "lucide-react": "^0.469.0",
    "motion": "^13.4.2",
    "nanoid": "^5.0.9",
    "next": "^15.5.26",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "9.3.10",
    "tailwind-merge": "^2.6.0",
    "unpdf": "1.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/eslint-plugin-next": "^15.5.26",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.26",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
