{
  "expo": {
    "name": "Dashfort Dev",
    "slug": "dashfort-mobile-dev",
    "version": "0.2.2",
    "scheme": "dashfort-dev",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.demfort.dashfort.dev",
      "supportsTablet": true
    },
    "android": {
      "package": "com.demfort.dashfort.dev",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ],
      "googleServicesFile": "./google-services.json",
      "versionCode": 13
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "./plugins/with-local-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Dashfort usa la cámara para tomar fotos que decidas adjuntar.",
          "photosPermission": "Dashfort abre el selector de fotos cuando eliges un adjunto.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "updates": {
      "enabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "icon": "./assets/icon.png"
  }
}
